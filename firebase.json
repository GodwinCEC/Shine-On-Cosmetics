{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/about", "destination": "/contact.html" },
      { "source": "/shop", "destination": "/shop.html" },
      { "source": "/product", "destination": "/product.html" },
      { "source": "/cart", "destination": "/cart.html" },
      { "source": "/checkout", "destination": "/checkout.html" },
      { "source": "/dashboard", "destination": "/dashboard.html" },
      { "source": "/auth", "destination": "/auth.html" },
      { "source": "/admin", "destination": "/admin/index.html" },
      { "source": "/admin/!(*.*)", "destination": "/admin/index.html" }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
